{
  "name": "greenscreen-kids",
  "version": "1.0.0",
  "description": "Magic Screen: a kindergarten-friendly green screen app (web, iPad, phone)",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "postinstall": "node scripts/copy-mediapipe.mjs",
    "e2e": "playwright test",
    "harness": "node e2e/harness/run.ts",
    "fixtures": "node e2e/fixtures/gen/generate.ts"
  },
  "license": "CC-BY-NC-SA-4.0",
  "type": "module",
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/quicksand": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.1.1",
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
